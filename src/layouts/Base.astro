---
import '../styles/global.css';
import site from '../../site.config.mjs';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Metrika from '../components/Metrika.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  jsonLd?: object;
  /** Keeps the page out of the index and drops its canonical (the 404 has no URL of its own). */
  noindex?: boolean;
}
const { title, description, ogImage = '/og/home.png', jsonLd, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogUrl = new URL(ogImage, Astro.site);
// `<` inside a <script> body ends the element, whatever the JSON quoting says. Escaping it
// keeps a stray angle bracket in the config from closing the tag and injecting markup.
const jsonLdText = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : '';
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.firstName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="ru_RU" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {jsonLd && <script is:inline type="application/ld+json" set:html={jsonLdText} />}
    {/* Runs before first paint, so revealed elements never flash in and then hide. The class
        gates the hidden state: no script, no observer or motion turned down — no hiding. */}
    <script is:inline>
      if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('js');
      }
    </script>
  </head>
  <body class="bg-white font-sans text-neutral-900 antialiased">
    {/* Counter sits at the top of <body>, not in <head>: its <noscript><div><img> fallback
        is not valid head content and the parser moves it into the body anyway. */}
    {site.metrikaId && <Metrika id={site.metrikaId} />}
    <Header />
    <slot />
    <Footer />
    <script is:inline>
      (() => {
        // Headings assemble letter by letter. Split by words first: a bare chain of inline
        // letters would let a line break land inside a word.
        if (!document.documentElement.classList.contains('js')) return;
        const headings = document.querySelectorAll('[data-assemble]');
        try {
        for (const heading of headings) {
          const words = heading.textContent.trim().split(/(\s+)/);
          heading.textContent = '';
          let n = 0;
          for (const word of words) {
            const wrap = document.createElement('span');
            for (const char of word) {
              const glyph = document.createElement('span');
              glyph.textContent = char;
              glyph.style.setProperty('--dx', (Math.random() * 24 - 12).toFixed(1) + 'px');
              glyph.style.setProperty('--dy', (Math.random() * 22 - 6).toFixed(1) + 'px');
              glyph.style.setProperty('--rot', (Math.random() * 10 - 5).toFixed(1) + 'deg');
              glyph.style.transitionDelay = Math.min(n * 22, 700) + 'ms';
              wrap.appendChild(glyph);
              n++;
            }
            heading.appendChild(wrap);
          }
          heading.setAttribute('data-split', '');
        }
        } catch (e) {
          // A heading that failed to split must still be readable — show them all as they are.
          for (const heading of headings) heading.setAttribute('data-split', '');
        }
      })();
    </script>
    <script is:inline>
      (() => {
        const items = document.querySelectorAll('[data-reveal], [data-assemble]');
        if (!items.length) return;
        // `.js` is set in <head> only when the reveal can actually run; without it the
        // elements were never hidden and there is nothing to reveal.
        if (!document.documentElement.classList.contains('js')) return;
        const io = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            const el = entry.target;
            const step = Math.min(Number(el.dataset.revealIndex || 0), 5) * 70;
            el.style.transitionDelay = step + 'ms';
            el.setAttribute('data-revealed', '');
            io.unobserve(el);
          }
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.05 });
        for (const el of items) io.observe(el);
      })();
    </script>
  </body>
</html>
