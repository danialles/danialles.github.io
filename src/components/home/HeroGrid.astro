---
// Three layers behind the hero headline: a static dot grid that leans towards the cursor,
// ribbons made of summed sines drifting across it, and slow motes rising through both.
// Purely decorative, hence aria-hidden and pointer-events-none.
---
<canvas
  data-hero-grid
  aria-hidden="true"
  class="hero-grid pointer-events-none absolute inset-0 -z-10 h-full w-full"
></canvas>

<script is:inline>
  (() => {
    const canvas = document.querySelector('[data-hero-grid]');
    if (!canvas) return;
    const ctx = canvas.getContext('2d', { alpha: true });
    if (!ctx) return;

    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    // Touch screens get the same wave, just a sparser field: fewer dots, no cursor logic.
    const coarse = matchMedia('(pointer: coarse)').matches;
    const STEP = coarse ? 32 : 26;
    const REACH = 130;
    const pointer = { x: -9999, y: -9999, on: false };
    let w = 0;
    let h = 0;
    let raf = 0;
    let running = false;
    let t = 0;

    const resize = () => {
      const rect = canvas.getBoundingClientRect();
      // Cap the pixel ratio: on a 3x phone the extra pixels cost more than they show.
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = rect.width;
      h = rect.height;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };

    // Floating motes: slow risers with a soft radial falloff, the layer that reads as air.
    const MOTES = coarse ? 7 : 14;
    let motes = [];
    const seedMotes = () => {
      motes = Array.from({ length: MOTES }, () => ({
        x: Math.random() * w,
        y: Math.random() * h,
        r: 3 + Math.random() * 7,
        speed: 6 + Math.random() * 14,
        wobble: 8 + Math.random() * 18,
        rate: 0.4 + Math.random() * 0.8,
        phase: Math.random() * Math.PI * 2,
        alpha: 0.05 + Math.random() * 0.09,
      }));
    };

    const drawDots = () => {
      for (let x = STEP; x < w; x += STEP) {
        for (let y = STEP; y < h; y += STEP) {
          let dx = 0;
          let dy = 0;
          let near = 0;
          if (pointer.on) {
            const vx = pointer.x - x;
            const vy = pointer.y - y;
            const dist = Math.hypot(vx, vy);
            if (dist < REACH) {
              near = 1 - dist / REACH;
              // Dots drift towards the cursor, never far enough to break the grid.
              dx = vx * near * 0.22;
              dy = vy * near * 0.22;
            }
          }
          ctx.beginPath();
          ctx.arc(x + dx, y + dy, 1 + near * 1.5, 0, Math.PI * 2);
          ctx.fillStyle = near > 0 ? `rgba(37, 78, 214, ${0.16 + near * 0.5})` : 'rgba(15, 23, 42, 0.10)';
          ctx.fill();
        }
      }
    };

    // One ribbon: three sines of different wavelength summed, which never repeats visibly.
    const drawWave = (baseY, amp, speed, width, alpha) => {
      ctx.beginPath();
      for (let x = 0; x <= w; x += 6) {
        const y =
          baseY +
          Math.sin(x * 0.0042 + t * speed) * amp +
          Math.sin(x * 0.011 + t * speed * 1.35) * amp * 0.4 +
          Math.sin(x * 0.0018 - t * speed * 0.7) * amp * 0.7;
        x === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
      }
      ctx.strokeStyle = `rgba(37, 78, 214, ${alpha})`;
      ctx.lineWidth = width;
      ctx.stroke();
    };

    const drawMotes = (dt) => {
      for (const m of motes) {
        m.y -= m.speed * dt;
        m.phase += m.rate * dt;
        if (m.y + m.r < 0) {
          m.y = h + m.r;
          m.x = Math.random() * w;
        }
        const x = m.x + Math.sin(m.phase) * m.wobble * 0.3;
        const g = ctx.createRadialGradient(x, m.y, m.r * 0.1, x, m.y, m.r);
        g.addColorStop(0, `rgba(37, 78, 214, ${m.alpha})`);
        g.addColorStop(1, 'rgba(37, 78, 214, 0)');
        ctx.beginPath();
        ctx.arc(x, m.y, m.r, 0, Math.PI * 2);
        ctx.fillStyle = g;
        ctx.fill();
      }
    };

    const draw = (dt = 0) => {
      ctx.clearRect(0, 0, w, h);
      drawDots();
      drawWave(h * 0.52, 26, 0.45, 1.6, 0.16);
      drawWave(h * 0.62, 18, 0.62, 1.2, 0.1);
      drawWave(h * 0.44, 14, 0.34, 1, 0.07);
      drawMotes(dt);
    };

    let last = 0;
    const loop = (now) => {
      // Time drives the wave, not the frame count: the speed is the same on 60 and 120 Hz.
      const dt = Math.min(now - last, 50) / 1000;
      t += dt;
      last = now;
      draw(dt);
      raf = requestAnimationFrame(loop);
    };
    const start = () => {
      if (running || still) return;
      running = true;
      last = performance.now();
      raf = requestAnimationFrame(loop);
    };
    const stop = () => {
      running = false;
      cancelAnimationFrame(raf);
    };

    // The canvas is absolutely positioned, so its size comes from hero content that is still
    // being parsed when this script runs: measuring now yields 0×0. The observer fires once
    // the box exists and again whenever the text reflows.
    if ('ResizeObserver' in window) {
      new ResizeObserver(() => { resize(); seedMotes(); draw(); }).observe(canvas);
    } else {
      window.addEventListener('load', () => { resize(); seedMotes(); draw(); });
    }

    if (!still) {
      if (!coarse) {
        window.addEventListener('pointermove', (e) => {
          const rect = canvas.getBoundingClientRect();
          pointer.x = e.clientX - rect.left;
          pointer.y = e.clientY - rect.top;
          pointer.on = true;
        }, { passive: true });
        window.addEventListener('pointerleave', () => { pointer.on = false; }, { passive: true });
      }
      // The loop only runs while the hero is on screen — scrolling past it costs nothing.
      new IntersectionObserver((entries) => {
        entries[0].isIntersecting ? start() : stop();
      }, { threshold: 0 }).observe(canvas);
      // A hidden tab keeps firing rAF in some browsers; stop on the way out either way.
      document.addEventListener('visibilitychange', () => {
        document.hidden ? stop() : start();
      });
    }
  })();
</script>
