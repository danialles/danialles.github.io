---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { roleLabel } from '../../lib/cases';

interface Props { entry: CollectionEntry<'cases'>; index?: number }
const { entry, index = 0 } = Astro.props;
const { data } = entry;
---
<a href={`/cases/${entry.id}/`} class="group block" data-reveal data-reveal-index={index}>
  {/* The frame clips the zoom; the outline is pure black at low alpha, so it reads as an edge
      on any cover instead of picking up a tint from the image behind it. */}
  <div class="overflow-hidden rounded-xl outline outline-1 -outline-offset-1 outline-black/10 transition-shadow duration-200 group-hover:shadow-[0_1px_2px_rgba(0,0,0,.04),0_18px_36px_-20px_rgba(0,0,0,.45)]">
    <Image
      src={data.cover}
      alt={data.coverAlt}
      widths={[360, 480, 720, 960]}
      sizes="(max-width: 767px) calc(100vw - 2rem), (max-width: 1279px) 480px, 320px"
      class="aspect-[16/10] w-full object-cover object-top transition-transform duration-300 ease-[cubic-bezier(0.2,0,0,1)] group-hover:scale-[1.03]"
    />
  </div>
  <p class="mt-3 text-sm text-neutral-600">{data.niche} · {roleLabel(data.role)}</p>
  <h3 class="mt-1 text-lg font-semibold transition-colors duration-200 group-hover:text-accent">{data.title}</h3>
  <p class="mt-1 text-neutral-600">{data.result}</p>
</a>
