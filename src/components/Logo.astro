---
import site from '../../site.config.mjs';

// The mark is the hero's dot field compressed to a 3×3 grid — no tile behind it, so it sits
// on the white page instead of punching a dark hole in it. The accent dot slides on hover;
// that is the whole animation, a logo that twitches is a distraction.
interface Props { class?: string }
const { class: className = '' } = Astro.props;
---
{/* h-10 w-10 keeps the tap target at 40px even though the mark itself is 24px. */}
<a
  href="/"
  class={`group -m-2 inline-flex h-10 w-10 items-center justify-center rounded-xl p-2 transition-colors duration-200 hover:bg-neutral-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent ${className}`}
  aria-label={`${site.firstName} — на главную`}
>
  <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" aria-hidden="true">
    <g class="fill-neutral-400 transition-colors duration-200 group-hover:fill-neutral-500">
      <circle cx="4.5" cy="4.5" r="1.5" /><circle cx="12" cy="4.5" r="1.5" />
      <circle cx="4.5" cy="12" r="1.5" /><circle cx="12" cy="12" r="1.5" /><circle cx="19.5" cy="12" r="1.5" />
      <circle cx="4.5" cy="19.5" r="1.5" /><circle cx="12" cy="19.5" r="1.5" /><circle cx="19.5" cy="19.5" r="1.5" />
    </g>
    <circle
      cx="19.5" cy="4.5" r="2.6" fill="var(--color-accent)"
      class="origin-center transition-transform duration-300 ease-[cubic-bezier(0.2,0,0,1)] group-hover:translate-x-[-7.5px] group-hover:translate-y-[7.5px]"
    />
  </svg>
</a>
